// This creates a new slide
slide "MySlide"
// This creates a new Rect element
newelem "ColorRect" Rect (
    position: (100, "h * 0.5"),
    anchor: TopRight,
    alignment: RightCenter,
    source: Color(1.0, 0.5, 0.0, 1.0),
    corner_rounding: Circle(
        top_left: 1.0,
        top_right: 0.5,
        bottom_left: 1.0,
        bottom_right: 0.5
    )
)

slide "MySecondSlide"
// Destroys the "ColorRect" element of the "MySlide" slide
discard MySlide::ColorRect