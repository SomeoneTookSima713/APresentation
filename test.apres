# This part gets parsed like regular TOML and thus requires a different comment syntax
[[image]]
    path = "test.png"

---
// This creates a new slide
slide "MySlide" (0.1, 0.1, 0.13)
// This creates a new Rect element
newelem "ColorRect" Rect (
    position: (0, 0),
    size: (Rhai("0.5*w"), Rhai("0.5*w")),
    anchor: MidCenter,
    alignment: Custom(Rhai("math::sin(t*0.1)*0.5 + 0.5"), 0.5),
    source: Image("test.png", Nearest),
    corner_rounding: {
        top_left: 0.7,
        top_right: 0.5,
        bottom_left: 0.5,
        bottom_right: 1.0
    },
    z_index: 0
)

slide "MySecondSlide" (1.0, 1.0, 1.0)
// Destroys the "ColorRect" element of the "MySlide" slide
discard "MySlide::ColorRect"